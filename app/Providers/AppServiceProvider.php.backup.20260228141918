<?php

namespace App\Providers;

use Illuminate\Support\ServiceProvider;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Facades\View;


class AppServiceProvider extends ServiceProvider
{
    /**
     * Register any application services.
     */
    public function register(): void
    {
        //
    }

    /**
     * Bootstrap any application services.
     */
    public function boot(): void
    {
        Schema::defaultStringLength(191);

        // Register VideoStreaming module views
        $this->loadViewsFrom(base_path('Modules/VideoStreaming/Resources/views'), 'videostreaming');

        // Register Guide module views
        $this->loadViewsFrom(base_path('Modules/Guide/Resources/views'), 'guide');

        // Register Marketing module views
        $this->loadViewsFrom(base_path('Modules/Marketing/Resources/views'), 'marketing');

        // Load Marketing routes
        if (file_exists(base_path('Modules/Marketing/Routes/web.php'))) {
            \Illuminate\Support\Facades\Route::middleware('web')
                ->group(base_path('Modules/Marketing/Routes/web.php'));
        }
    }
}
