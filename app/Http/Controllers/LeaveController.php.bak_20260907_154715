    }

    /**
     * Compute the leave-balance snapshot for ONE employee, scoped to the
     * company (creator) that owns the leave-type catalog.
     *
     * Balance is derived — not stored — so it stays in sync automatically
     * with approvals and rejections. Counts leaves where status != 'Reject'
     * and that fall within the current calendar year (partially or fully);
     * leaves that straddle the year boundary are pro-rated.
     *
     * Returns an array of rows:
     *   [ ['id' => int, 'title' => string, 'days' => int (allocation),
     *      'total_leave' => int (used), 'remaining' => int], ... ]
     *
     * An OPTIONAL per-employee override (table: employee_leave_balances)
     * replaces the default `leave_types.days` allocation when a row exists.
     * When the table is absent (older installs) we silently skip the lookup.
     */
    public static function computeLeaveBalances($employeeId, $creatorId = null)
    {
        if (empty($employeeId)) return [];
        if (is_null($creatorId)) {
            $creatorId = \Auth::check() ? \Auth::user()->creatorId() : null;
        }

        $year = date('Y');
        $leave_types = LeaveType::where('created_by', $creatorId)->get();

        // Try to read per-employee overrides (table is optional, may not exist yet)
        $overrides = [];
        try {
            if (\Illuminate\Support\Facades\Schema::hasTable('employee_leave_balances')) {
                $overrideRows = \Illuminate\Support\Facades\DB::table('employee_leave_balances')
                    ->where('employee_id', $employeeId)
                    ->get();
                foreach ($overrideRows as $row) {
                    $overrides[$row->leave_type_id] = (int) $row->allocation;
                }
            }
        } catch (\Throwable $e) { /* fail soft — fall back to defaults */ }

        $out = [];
        foreach ($leave_types as $type) {
            $counts = Leave::select(\DB::raw('
                COALESCE(SUM(
                    CASE
                        WHEN YEAR(start_date) = ? AND YEAR(end_date) = ? THEN total_leave_days
                        WHEN YEAR(start_date) = ? THEN DATEDIFF(LAST_DAY(start_date), start_date) + 1
                        WHEN YEAR(end_date) = ? THEN DATEDIFF(end_date, DATE_FORMAT(end_date, "%Y-01-01")) + 1
                        ELSE 0
                    END
                ), 0) AS total_leave
            '))
                ->where('leave_type_id', $type->id)
                ->where('employee_id', $employeeId)
                ->where('status', '!=', 'Reject')
                ->where(function ($q) use ($year) {
                    $q->whereYear('start_date', $year)->orWhereYear('end_date', $year);
                })
                ->addBinding([$year, $year, $year, $year], 'select')
                ->first();

            $used       = $counts ? (int) $counts['total_leave'] : 0;
            $allocation = isset($overrides[$type->id]) ? $overrides[$type->id] : (int) $type->days;
            $remaining  = max(0, $allocation - $used);

            $out[] = [
                'id'          => $type->id,
                'title'       => $type->title,
                'days'        => $allocation,
                'total_leave' => $used,
                'remaining'   => $remaining,
            ];
        }
        return $out;
    }


    /**
     * Delete a leave attachment.
     */
    public function deleteAttachment($id)
    {
        $attachment = LeaveAttachment::find($id);

        if (!$attachment) {
            return response()->json(['success' => false, 'message' => __('Attachment not found.')], 404);
        }

        $leave = Leave::find($attachment->leave_id);

        if (!$leave || $leave->created_by != Auth::user()->creatorId()) {
            return response()->json(['success' => false, 'message' => __('Permission denied.')], 403);
        }

        // Delete file from uploads folder
        $fullPath = base_path($attachment->file_path);
        if (file_exists($fullPath)) {
            unlink($fullPath);
        }

        $attachment->delete();

        return response()->json(['success' => true, 'message' => __('Attachment deleted successfully.')]);
    }
