<script>
    $(document).ready(function() {
        // Role-to-name mapping from server
        var roleNames = @json($roles);

        function toggleSalesGroup() {
            var selectedRoleId = $('#user_role').val();
            var roleName = roleNames[selectedRoleId] || '';
            var isSalesRole = roleName.toLowerCase().indexOf('sales') !== -1;

            if (isSalesRole) {
                $('.sales_group_div').removeClass('d-none');
            } else {
                $('.sales_group_div').addClass('d-none');
                $('#sales_group').val('');
            }
        }

        $('#user_role').on('change', toggleSalesGroup);
        toggleSalesGroup(); // check on load
    });
</script>
