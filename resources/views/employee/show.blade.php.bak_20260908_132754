        @if($employee && $employee->user_id)
        <div class="row mt-4">
            <div class="col-12">
                <div class="card mb-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">{{ __('Performance & Productivity') }} <small class="text-muted">({{ __('last 30 days') }})</small></h5>
                        <span class="badge bg-light-primary">{{ __('Auto-computed') }}</span>
                    </div>
                    <div class="card-body" id="atProfileWidget">
                        <div class="text-muted text-center py-3"><i class="ti ti-loader"></i> {{ __('Loading…') }}</div>
                    </div>
                </div>
            </div>
        </div>
        <script>
        (function() {
            const userId = {{ (int) $employee->user_id }};
            const url = "{{ url('/activity/performance') }}/" + userId;
            const wrap = document.getElementById('atProfileWidget');
            if (!wrap) return;

            function stars(n) {
                const filled = Math.max(0, Math.min(5, parseInt(n||0,10)));
                return '★'.repeat(filled) + '☆'.repeat(5 - filled);
            }
            function pct(v) { return ((parseFloat(v||0)) * 100).toFixed(1) + '%'; }

            function placeholder(text, color) {
                const p = document.createElement('p');
                p.className = 'text-muted text-center py-3';
                if (color) p.classList.add(color);
                p.textContent = text;
                return p;
            }

            function metric(labelText, valueText, valueClass) {
                const col = document.createElement('div');
                col.className = 'col-md-3 col-6 text-center';
                const lbl = document.createElement('div');
                lbl.className = 'text-muted small';
                lbl.textContent = labelText;
                const val = document.createElement('div');
                val.className = 'h4 mb-0 ' + (valueClass || '');
                val.textContent = valueText;
                col.appendChild(lbl);
                col.appendChild(val);
                return col;
            }

            fetch(url, { credentials: 'same-origin', headers: { 'Accept':'application/json' } })
                .then(r => r.json())
                .then(d => {
                    wrap.replaceChildren();
                    if (!d.enabled) {
                        wrap.appendChild(placeholder('Activity tracking is currently disabled.'));
                        return;
                    }
                    if (!d.days) {
                        wrap.appendChild(placeholder('No performance data yet — score is computed nightly from task time.'));
                        return;
                    }
                    const row = document.createElement('div');
                    row.className = 'row gy-3 align-items-center';

                    // Stars
                    const starsCol = document.createElement('div');
                    starsCol.className = 'col-md-3 col-6 text-center';
                    const starsLabel = document.createElement('div');
                    starsLabel.className = 'text-muted small';
                    starsLabel.textContent = 'Rating';
                    const starsValue = document.createElement('div');
                    starsValue.className = 'h3 mb-0';
                    starsValue.style.color = '#f5b400';
                    starsValue.style.letterSpacing = '2px';
                    starsValue.textContent = stars(d.stars);
                    starsCol.appendChild(starsLabel);
                    starsCol.appendChild(starsValue);

                    row.appendChild(starsCol);
                    row.appendChild(metric('Score',         (d.score * 100).toFixed(0) + '%', 'text-primary'));
                    row.appendChild(metric('Productivity',  pct(d.productivity), 'text-success'));
                    row.appendChild(metric('Idle ratio',    pct(d.idle_ratio), parseFloat(d.idle_ratio) > 0.3 ? 'text-warning' : ''));
                    wrap.appendChild(row);

                    const note = document.createElement('div');
                    note.className = 'text-muted small text-center mt-3';
                    note.textContent = 'Based on ' + d.days + ' days of tracked activity.';
                    wrap.appendChild(note);
                })
                .catch(() => {
                    wrap.replaceChildren();
                    wrap.appendChild(placeholder('Could not load performance data.'));
                });
        })();
        </script>
