    // Handle attachment deletion
    $(document).on('click', '.delete-attachment', function(e) {
        e.preventDefault();
        var button = $(this);
        var attachmentId = button.data('id');
        var url = button.data('url');

        if (confirm("{{ __('Are you sure you want to delete this attachment?') }}")) {
            $.ajax({
                url: url,
                type: 'DELETE',
                data: {
                    _token: '{{ csrf_token() }}'
                },
                success: function(response) {
                    if (response.success) {
                        $('#attachment-' + attachmentId).fadeOut(300, function() {
                            $(this).remove();
                            // Check if no attachments left
                            if ($('#current-attachments').children().length === 0) {
                                $('#current-attachments').closest('.row').remove();
                            }
                        });
                        show_toastr('success', response.message, 'success');
                    } else {
                        show_toastr('error', response.message, 'error');
                    }
                },
                error: function(xhr) {
                    show_toastr('error', "{{ __('Error deleting attachment.') }}", 'error');
                }
            });
        }
    });
</script>
